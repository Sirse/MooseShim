// Generated from cmake/version.rc.in - do not edit.
//
// Without a version resource the DLL is anonymous in Explorer and in any bug
// report: "which build is installed" has no answer. This is also the right
// place for authorship - not the exported names, not the registry key, not the
// string SDA shows in its hardware list.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @SHIM_VERSION_COMMA@
PRODUCTVERSION @SHIM_VERSION_COMMA@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "@SHIM_AUTHOR@"
            VALUE "FileDescription",  "J2534 v04.04 pass-through shim for Volvo SDA"
            VALUE "FileVersion",      "@SHIM_VERSION@"
            VALUE "InternalName",     "@SHIM_NAME@"
            VALUE "LegalCopyright",   "@SHIM_COPYRIGHT@"
            VALUE "OriginalFilename", "@SHIM_NAME@.dll"
            VALUE "ProductName",      "@SHIM_NAME@"
            VALUE "ProductVersion",   "@SHIM_VERSION@"
            VALUE "Comments",         "Not affiliated with Volvo Car Corporation or Drew Technologies."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
